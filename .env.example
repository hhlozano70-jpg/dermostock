# Puerto para el servidor (Render lo asigna automáticamente a través de $PORT)
PORT=3000
NODE_ENV=production

# ===================================================================
# FIREBASE FIRESTORE CONFIGURATION (Para Render y sincronización Cloud)
# ===================================================================
# OPCIÓN A (Recomendada para Render):
# Pega todo el contenido del archivo JSON de tu Service Account de Firebase en una sola línea o en un bloque:
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"tu-proyecto",...}'

# OPCIÓN B (Variables individuales):
# FIREBASE_PROJECT_ID="tu-proyecto-id"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@tu-proyecto.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBA...-----END PRIVATE KEY-----\n"

# OPCIÓN C (Ruta a archivo local):
# FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
